---
const {type='terminal',large=false}=Astro.props;
---
<div class:list={['art',type,{large}]} aria-hidden="true"><div class="art-grid"></div>{type==='terminal'?<div class="terminal-window"><div class="terminal-bar"><i></i><i></i><i></i><span>enes@homelab: ~</span></div><div class="terminal-code"><span class="muted"># küçük bir komut, büyük bir fark.</span><br/><span class="green">❯</span> sudo apt update<br/><span class="muted">Paket listeleri okunuyor... Tamamlandı</span><br/><span class="green">❯</span> systemctl status nginx<br/><span class="green">●</span> nginx.service <span class="muted">— active (running)</span><br/><span class="green">❯</span> <span class="cursor">▍</span></div><div class="terminal-status"><span>● SSH bağlantısı aktif</span><span>UTF-8</span></div></div>:type==='network'?<div class="network-drawing"><span class="node main-node">⌘</span><div class="network-line"></div><div class="network-nodes"><span class="node">▤</span><span class="node">▤</span><span class="node">▤</span></div><span class="art-label">CONNECTED. PROTECTED.</span></div>:type==='docker'?<div class="docker-drawing"><div class="containers">{Array.from({length:6}).map(()=> <span>▦</span>)}</div><div class="ship">≈</div><span class="art-label">BUILD. SHIP. RUN.</span></div>:type==='code'?<div class="code-drawing"><span class="muted"># işleri otomatiğe bağla</span><br/><span class="green">$servers</span> | ForEach-Object {'{'}<br/>&nbsp; <span class="purple">Get-Service</span> -ComputerName $_<br/>&nbsp; | <span class="purple">Where-Object</span> Status -eq Running<br/>{'}'}<br/><span class="green">❯ ▍</span></div>:type==='cloud'?<div class="cloud-drawing"><span>☁</span><div>↑ <i>▤</i> ↓</div><span class="art-label">YOUR INFRASTRUCTURE. REIMAGINED.</span></div>:<div class="backup-drawing"><span>◴</span><strong>3 · 2 · 1</strong><small>HER ZAMAN BİR GERİ DÖNÜŞ YOLU.</small></div>}</div>
