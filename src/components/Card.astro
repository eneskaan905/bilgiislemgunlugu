---
import Art from './Art.astro';
const {post}=Astro.props;const p=post.data;
---
<article class="post-card reveal" data-category={p.category} data-title={(p.title+' '+p.description+' '+p.tags.join(' ')).toLocaleLowerCase('tr')}><a href={'/yazilar/'+post.id+'/'} class="art-link" tabindex="-1" aria-hidden="true">{p.cover?<img class="art cover-image" src={p.cover} alt="" loading="lazy" width="600" height="360"/>:<Art type={p.art}/>}<span class="art-arrow">↗</span></a><div class="card-body"><div class="card-meta"><span class="category">{p.category}</span><span>{p.minutes} dk okuma</span></div><h3><a href={'/yazilar/'+post.id+'/'}>{p.title}</a></h3><p>{p.description}</p><div class="card-bottom"><time datetime={p.date.toISOString()}>{p.date.toLocaleDateString('tr-TR',{day:'numeric',month:'long',year:'numeric'})}</time><span>↗</span></div></div></article>
