---
import {getCollection} from 'astro:content';
import ContentPage from '../../components/ContentPage.astro';
export async function getStaticPaths(){return (await getCollection('pages',({data})=>!data.draft)).map(page=>({params:{id:page.id},props:{page}}))}
if(Astro.props.page.id==='hakkinda')return Astro.redirect('/hakkinda/',301);
---
<ContentPage page={Astro.props.page}/>
