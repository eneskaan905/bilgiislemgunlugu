---
import {getCollection} from 'astro:content';
import ContentPage from '../components/ContentPage.astro';
export async function getStaticPaths(){return (await getCollection('pages',({data})=>!data.draft)).filter(p=>p.id==='hakkinda').map(page=>({params:{page:page.id},props:{page}}))}
---
<ContentPage page={Astro.props.page}/>
