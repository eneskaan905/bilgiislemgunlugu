---
import Layout from '../layouts/Layout.astro';
import Art from '../components/Art.astro';
import Card from '../components/Card.astro';
import Logo from '../components/Logo.astro';
import {categories} from '../data/categories';
import {getCollection} from 'astro:content';
import home from '../data/home.json';
import site from '../data/site.json';
const posts=(await getCollection('posts',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const featured=posts.find(p=>p.data.featured)||posts[0];
---
<Layout><section class="hero container"><div class="hero-copy"><div class="eyebrow"><span class="live-dot"></span> {home.eyebrow}</div><h1>{home.titleStart} <span>{home.titleAccent}</span><br/>{home.titleSecond}<span class="dot">.</span></h1><p>{home.description}</p><div class="hero-buttons"><a class="button primary" href={home.primaryHref}>{home.primaryLabel} <span>↗</span></a><a class="text-button" href={home.secondaryHref}>{home.secondaryLabel} <span>→</span></a></div><div class="hero-note"><span class="tiny-code">&lt;/&gt;</span> {home.note}</div></div><div class="hero-visual"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="floating-label label-top"><span class="live-dot"></span> {home.statusLabel}</div><Art type="terminal" large/><div class="floating-label label-bottom"><span>↳</span> {home.visualLabel}</div><span class="visual-plus plus-one">+</span><span class="visual-plus plus-two">+</span></div></section>
{home.showTopics&&<section class="topics-strip" id="konular"><div class="container topics-inner"><span class="topics-title">{home.topicsLabel}</span>{categories.map(c=><a href={'/yazilar/kategori/'+c.slug+'/'}><span>{c.icon}</span>{c.name}</a>)}</div></section>}
{home.showFeatured&&featured&&<section class="container featured-section reveal"><div class="section-heading"><div><span class="eyebrow">{home.featuredEyebrow}</span><h2>{home.featuredTitle}</h2></div><span class="handwritten">{home.featuredNote}</span></div><a class="featured-card" href={'/yazilar/'+featured.id+'/'}><div class="featured-copy"><span class="featured-badge">✧ {home.featuredBadge}</span><h2>{featured.data.title}</h2><p>{featured.data.description}</p><div class="featured-meta"><span class="avatar">{site.author.slice(0,1)}</span><span><strong>{site.author}</strong><small>{featured.data.date.toLocaleDateString('tr-TR',{day:'numeric',month:'long',year:'numeric'})} <span>·</span> {featured.data.minutes} dk okuma</small></span><span class="round-arrow">↗</span></div></div>{featured.data.cover?<img class="art cover-image" src={featured.data.cover} alt="" width="720" height="420"/>:<Art type={featured.data.art} large/>}</a></section>}
<section class="container posts-section home-posts" id="son-yazilar"><div class="section-heading"><div><span class="eyebrow">{home.recentEyebrow}</span><h2>{home.recentTitle}<span class="dot">.</span></h2></div><a class="archive-link" href="/yazilar/">{home.allPostsLabel} <span>↗</span></a></div><div class="posts-grid">{posts.slice(0,Math.min(6,Math.max(0,home.recentCount))).map(post=><Card post={post}/>)}</div><div class="home-archive-cta"><p>{home.archiveNote}</p><a class="button" href="/yazilar/">{home.archiveLabel} <span>→</span></a></div></section>
{home.showBanner&&<section class="container about-banner reveal"><div class="about-symbol"><Logo compact/></div><div><span class="eyebrow">{home.bannerEyebrow}</span><h2>{home.bannerTitle}</h2><p>{home.bannerDescription}</p></div><a class="button" href={home.bannerHref}>{home.bannerLabel} <span>↗</span></a></section>}
</Layout>
