---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
const { title = 'Bilgi İşlem Günlüğü — Tecrübeden rehbere.', description = 'Sistem yönetimi, ağ, Linux ve otomasyon üzerine sahadan notlar ve adım adım IT rehberleri.' } = Astro.props;
---
<!doctype html><html lang="tr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#0d9488"/><link rel="icon" type="image/svg+xml" sizes="any" href="/favicon-notebook-v2.svg"/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/><title>{title}</title></head><body>
<a class="skip" href="#main">İçeriğe geç</a>
<header class="header"><div class="container header-inner"><a href="/" class="brand" aria-label="Bilgi İşlem Günlüğü ana sayfa"><Logo/><span>bilgi işlem<span class="brand-bottom">günlüğü<span class="dot">.</span></span></span></a><nav aria-label="Ana menü"><a href="/" class:list={{active:Astro.url.pathname==='/'}}>Ana sayfa</a><a href="/yazilar/" class:list={{active:Astro.url.pathname.startsWith('/yazilar/')}}>Yazılar</a><a href="/#konular">Kategoriler</a><a href="/hakkinda/" class:list={{active:Astro.url.pathname==='/hakkinda/'}}>Hakkında</a></nav><div class="header-actions"><button class="search-open" aria-label="Yazılarda ara"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><span>Ara</span><kbd>⌘ K</kbd></button><button class="theme-toggle" aria-label="Renk temasını değiştir">◐</button></div></div></header>
<main id="main"><slot/></main>
<footer><div class="container footer-top"><a class="brand" href="/"><Logo/><span>bilgi işlem<span class="brand-bottom">günlüğü<span class="dot">.</span></span></span></a><p>Biriken tecrübe, paylaşıldıkça değerlenir.</p></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Bilgi İşlem Günlüğü</span><span>Merakla öğrenildi. Özenle paylaşıldı. <span class="dot">↗</span></span></div></footer>
<dialog id="search-dialog"><form method="dialog"><strong>Günlükte ara</strong><button aria-label="Aramayı kapat">✕</button></form><label for="global-search">Başlık, konu veya etiket</label><input id="global-search" type="search" placeholder="Örneğin: Linux, DNS, Docker…" autocomplete="off"/><div id="search-results" aria-live="polite"></div></dialog>
<script>
const dialog = document.querySelector<HTMLDialogElement>('#search-dialog')!;
const input = document.querySelector<HTMLInputElement>('#global-search')!;
let posts: {title:string;url:string;category:string;description:string}[] = [];
function results(){const q=input.value.toLocaleLowerCase('tr');const root=document.querySelector('#search-results')!;root.replaceChildren();const found=posts.filter(p=>(p.title+' '+p.category+' '+p.description).toLocaleLowerCase('tr').includes(q));for(const p of found){const a=document.createElement('a');a.href=p.url;const small=document.createElement('small');small.textContent=p.category;const strong=document.createElement('strong');strong.textContent=p.title;a.append(small,strong);root.append(a)}if(!found.length)root.textContent='Sonuç bulunamadı. Farklı bir kelime deneyebilirsin.'}
async function openSearch(){dialog.showModal();input.focus();try{posts=await fetch('/search.json').then(r=>r.json());results()}catch{document.querySelector('#search-results')!.textContent='Arama yüklenemedi. Lütfen tekrar dene.'}}
document.querySelector('.search-open')?.addEventListener('click',openSearch);input.addEventListener('input',results);document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();openSearch()}});dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
try{if(localStorage.getItem('theme')==='dark')document.documentElement.dataset.theme='dark'}catch{}
document.querySelector('.theme-toggle')?.addEventListener('click',()=>{const value=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=value;try{localStorage.setItem('theme',value)}catch{}});
document.addEventListener('click',e=>{if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;const ring=document.createElement('span');ring.className='click-ring';ring.style.left=e.clientX+'px';ring.style.top=e.clientY+'px';document.body.append(ring);ring.addEventListener('animationend',()=>ring.remove());for(let i=0;i<5;i++){const dot=document.createElement('span');dot.className='click-spark';dot.style.cssText=`left:${e.clientX}px;top:${e.clientY}px;--x:${Math.cos(i*1.256)*32}px;--y:${Math.sin(i*1.256)*32}px`;document.body.append(dot);dot.addEventListener('animationend',()=>dot.remove())}});
const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');observer.unobserve(e.target)}}),{threshold:.08});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
</script></body></html>
